// Keel — Prisma schema.
//
// Datasource + generator only in Task 3. Models arrive in Tasks 4-6 (identity,
// work items, approvals + support) as sequential appends; the append-only audit
// grant lands in Task 7.
//
// Role separation (see docker/postgres-init.sql):
//   url       -> DATABASE_URL         role keel_app     — restricted runtime role
//                                     used by PrismaClient at request time.
//   directUrl -> MIGRATE_DATABASE_URL role keel_migrate — owns the public schema;
//                                     used by `prisma migrate` / `db pull` /
//                                     `studio` and by the integration-test
//                                     harness (src/test/db.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — the complete set from specs/data-model.md, defined here in Task 4 so
// Tasks 5 and 6 only add models, never re-touch an enum block. Values are
// SCREAMING_SNAKE_CASE, exactly as the spec lists them.
// ---------------------------------------------------------------------------

// Identity
enum UserKind {
  INTERNAL
  GUEST
}

enum Hat {
  DEVELOPER
  REVIEWER
  BUSINESS_APPROVER
  TECHNICAL_APPROVER
}

// Demand (spec 01)
enum DemandSource {
  CLIENT
  INCIDENT
  TECH_DEBT
  COMPLIANCE
  OPPORTUNITY
  INTERNAL
}

enum DemandStatus {
  SUBMITTED
  TRIAGING
  WORTH_ASSESSED
  APPROVED
  REJECTED
  CONVERTED
}

enum WorthDecision {
  PURSUE
  PARK
  DROP
}

enum Effort {
  S
  M
  L
}

// Incident (spec 02)
enum Level {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Change (spec 03)
enum ChangeType {
  NORMAL
  STANDARD
  EMERGENCY
}

enum ChangeStatus {
  DRAFT
  ASSESSING
  APPROVAL
  SCHEDULED
  IMPLEMENTING
  PIR
  CLOSED
  ROLLED_BACK
}

enum ValueRealized {
  YES
  PARTIAL
  NO
}

enum LinkKind {
  CAUSED_BY
  FIXES
}

// Approvals engine (spec 04)
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum DecisionKind {
  APPROVED
  REJECTED
}

// Support tables (spec 05, foundation)
enum NotificationKind {
  ASSIGNED
  APPROVAL_NEEDED
  STATUS_CHANGED
  COMMENTED
  OVERDUE
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity and tenancy (spec 00 §2, specs/data-model.md §"Identity and tenancy")
// ---------------------------------------------------------------------------

model Client {
  id        String        @id @default(cuid())
  name      String
  domain    String? // informational in v1 (no auto-join)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  users     User[]
  invites   GuestInvite[]
  demands   Demand[] // demands a guest of this client submitted (Task 5)
  incidents Incident[] // incidents a guest of this client reported (Task 5)
}

model User {
  // CHECK constraint user_guest_has_client (kind <> GUEST OR clientId IS NOT NULL) — see migration 20260903005643_user_guest_client_check
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // argon2id
  kind         UserKind
  hats         Hat[] // empty for guests
  displayName  String
  isActive     Boolean   @default(true) // deactivation kills sessions
  clientId     String? // set iff kind = GUEST
  client       Client?   @relation(fields: [clientId], references: [id])
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  sessions     Session[]
  accounts     Account[]

  // Work-item back-relations (Task 5). Users are deactivated (isActive=false),
  // never hard-deleted, so every work-item FK to User is Restrict by design — a
  // user who owns or scored work cannot be removed.
  submittedDemands  Demand[]                   @relation("DemandSubmitter")
  reportedIncidents Incident[]                 @relation("IncidentReporter")
  assignedIncidents Incident[]                 @relation("IncidentAssignee")
  ownedChanges      Change[]                   @relation("ChangeOwner")
  reviewedPirs      PostImplementationReview[] @relation("PirReviewer")
  valueScored       WorthAssessment[]          @relation("WorthValueScorer")
  effortScored      WorthAssessment[]          @relation("WorthEffortScorer")
  decisionsMade     WorthAssessment[]          @relation("WorthDecider")

  // Approvals + support back-relations (Task 6). An approval decision and a
  // comment are historical records → onDelete: Restrict (their author is
  // deactivated via isActive, never hard-deleted). A notification is per-user UI
  // ephemera with no audit value → onDelete: Cascade with the user.
  approvalDecisions ApprovalDecision[] @relation("ApprovalDecisionActor")
  comments          Comment[]          @relation("CommentAuthor")
  notifications     Notification[]     @relation("NotificationRecipient")

  @@index([clientId])
}

model Session {
  // Auth.js database-session shape + the extra columns the revoke UI needs.
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime @default(now()) @db.Timestamptz(3)
  userAgent    String?
  ip           String?

  @@index([userId])
}

model Account {
  // Auth.js `@auth/prisma-adapter` table — full adapter shape, unused in v1
  // (no OAuth). Present so Task 12 stays config-only whichever auth path holds.
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  // Auth.js adapter table. Unused in v1 (no email-link provider); present for
  // adapter completeness.
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model GuestInvite {
  id          String    @id @default(cuid())
  token       String    @unique // random 32-byte url-safe, stored hashed
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  email       String // the invitee
  createdById String // → User (internal); no FK, mirrors ApprovalRequest.createdById
  expiresAt   DateTime  @db.Timestamptz(3) // app sets now + 7 days
  redeemedAt  DateTime? @db.Timestamptz(3) // single-use
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Reference counters (specs/data-model.md §"Reference counters")
// `ref` values (DEM-, INC-, CHG-) increment inside the creating transaction.
// ---------------------------------------------------------------------------

model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Work items (spec 00 §2, specs/data-model.md §"Work items", specs 01/02/03)
//
// Controller rulings applied here:
//  (b) ownership / assignment / scoring *ById fields are real @relation to User
//      (not bare strings). Every such FK is Restrict — users are deactivated,
//      never hard-deleted, so a user who touched work cannot be removed.
//  (c) the Demand<->Change conversion is ONE foreign key. It lives on
//      Change.originatingDemandId (@unique); Demand.convertedToChange is a
//      pure back-relation named "DemandConversion". There is no stored
//      Demand.convertedToChangeId column.
//  (d) Demand 1:1 WorthAssessment (FK + @unique on WorthAssessment.demandId);
//      Change 1:1 PostImplementationReview (FK + @unique on PIR.changeId);
//      ChangeIncidentLink @@unique([changeId, incidentId, kind]).
//  (e) Incident.overdue is a stored Boolean with NO column default (the caller
//      always computes and passes it) + Incident.overdueNotifiedAt DateTime?.
// ---------------------------------------------------------------------------

model Demand {
  id              String       @id @default(cuid())
  ref             String       @unique // DEM-0001, monotonic per type
  title           String
  problem         String // plain-language need
  source          DemandSource
  status          DemandStatus
  submittedById   String
  submittedBy     User         @relation("DemandSubmitter", fields: [submittedById], references: [id])
  clientId        String? // set when a guest submitted it
  client          Client?      @relation(fields: [clientId], references: [id])
  affectedService String? // free text (v1)
  decidedAt       DateTime?    @db.Timestamptz(3) // worth decision timestamp
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  // Ruling (d): 1:1 worth assessment. Ruling (c): the conversion link seen from
  // the demand end — no stored column, navigates to the Change that holds the FK.
  worth             WorthAssessment?
  convertedToChange Change?          @relation("DemandConversion")

  @@index([status])
  @@index([clientId])
  @@index([submittedById])
}

model WorthAssessment {
  id                       String         @id @default(cuid())
  demandId                 String         @unique
  demand                   Demand         @relation(fields: [demandId], references: [id])
  businessValue            String? // narrative from a BUSINESS_APPROVER
  valueScore               Int? // 1–10, set by a BUSINESS_APPROVER
  valueScoredById          String? // must hold BUSINESS_APPROVER
  valueScoredBy            User?          @relation("WorthValueScorer", fields: [valueScoredById], references: [id], onDelete: Restrict)
  effort                   Effort? // set by a TECHNICAL_APPROVER
  feasibility              String? // narrative from a TECHNICAL_APPROVER
  effortScoredById         String? // must hold TECHNICAL_APPROVER
  effortScoredBy           User?          @relation("WorthEffortScorer", fields: [effortScoredById], references: [id], onDelete: Restrict)
  costOfDelay              String? // any internal user
  decision                 WorthDecision?
  decidedById              String?
  decidedBy                User?          @relation("WorthDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionNote             String?
  isSingleApproverOverride Boolean        @default(false) // true when decidedById == the demand's submittedById
  overrideJustification    String? // app-enforced: required (min 20 chars) when isSingleApproverOverride
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
}

model Incident {
  id                String         @id @default(cuid())
  ref               String         @unique // INC-0001
  title             String
  description       String
  affectedService   String // free text (v1)
  impact            Level
  urgency           Level
  priority          Priority // derived from impact × urgency, stored
  status            IncidentStatus
  reportedById      String
  reportedBy        User           @relation("IncidentReporter", fields: [reportedById], references: [id])
  clientId          String? // set when a guest reported it
  client            Client?        @relation(fields: [clientId], references: [id])
  assigneeId        String? // internal user
  assignee          User?          @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  dueAt             DateTime       @db.Timestamptz(3) // derived from priority at creation
  overdue           Boolean // Ruling (e): stored for indexing, NO default; recomputed on read + by the notify job
  overdueNotifiedAt DateTime?      @db.Timestamptz(3) // set once, the first time overdue flips true
  resolution        String? // required to enter RESOLVED
  resolvedAt        DateTime?      @db.Timestamptz(3)
  closedAt          DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  changeLinks ChangeIncidentLink[]

  @@index([status])
  @@index([clientId])
  @@index([assigneeId])
  @@index([priority])
  @@index([overdue])
}

model Change {
  id                  String       @id @default(cuid())
  ref                 String       @unique // CHG-0001
  title               String
  changeType          ChangeType
  rfc                 String? // the RFC body; required to leave ASSESSING
  riskLevel           Level? // required to leave ASSESSING
  impactAssessment    String? // required to leave ASSESSING
  rollbackPlan        String? // required to leave ASSESSING (enforced at the transition, not the column)
  testPlan            String?
  status              ChangeStatus
  ownerId             String
  owner               User         @relation("ChangeOwner", fields: [ownerId], references: [id])
  windowStart         DateTime?    @db.Timestamptz(3) // required to enter SCHEDULED
  windowEnd           DateTime?    @db.Timestamptz(3) // required to enter SCHEDULED
  originatingDemandId String?      @unique // Ruling (c): the single FK for the Demand<->Change conversion link
  originatingDemand   Demand?      @relation("DemandConversion", fields: [originatingDemandId], references: [id])
  implementedAt       DateTime?    @db.Timestamptz(3)
  closedAt            DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  pir           PostImplementationReview?
  incidentLinks ChangeIncidentLink[]

  @@index([status])
  @@index([ownerId])
}

model PostImplementationReview {
  id            String        @id @default(cuid())
  changeId      String        @unique
  change        Change        @relation(fields: [changeId], references: [id])
  valueRealized ValueRealized // YES | PARTIAL | NO
  lessons       String
  reviewedById  String
  reviewedBy    User          @relation("PirReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime      @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
}

model ChangeIncidentLink {
  id         String   @id @default(cuid())
  changeId   String
  change     Change   @relation(fields: [changeId], references: [id], onDelete: Cascade)
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind       LinkKind // CAUSED_BY | FIXES
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([changeId, incidentId, kind])
  @@index([incidentId])
}

// ---------------------------------------------------------------------------
// Approvals engine — generic, reusable (spec 04, specs/data-model.md
// §"Approvals engine (generic, reusable)")
//
// An ApprovalRequest targets any subject by (subjectType, subjectId) — "Change"
// in v1. Steps are ordered (1-based) and role-routed; each step records one or
// more decisions with actor / time / reason. The single-approver override is a
// decision flag plus a typed justification (DESIGN §3.4).
//
// Controller rulings applied here:
//  - Every DateTime carries @db.Timestamptz(3) (the timestamptz convention from
//    the 20260901190000_timestamptz migration).
//  - ApprovalRequest.createdById is a bare String with NO relation — an
//    attribution id, matching GuestInvite.createdById (Task 4). The SoD check
//    compares it against a decision's actorId in the service layer.
//  - ApprovalDecision.actorId IS a real @relation to User (onDelete: Restrict) —
//    a decision is a permanent record; its actor is deactivated, never deleted.
//  - ApprovalStep.requestId and ApprovalDecision.stepId cascade on delete so a
//    CANCELLED request tears its steps and decisions down cleanly.
//  - resolvedAt on both ApprovalRequest and ApprovalStep per DESIGN §4.2
//    (data-model.md omits them).
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id          String         @id @default(cuid())
  subjectType String // "Change" in v1
  subjectId   String
  policyKey   String // e.g. change.normal, change.highRisk
  status      ApprovalStatus @default(PENDING)
  createdById String // → User (the submitter); bare String, drives the SoD check
  resolvedAt  DateTime?      @db.Timestamptz(3) // set when status leaves PENDING (DESIGN §4.2)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  steps ApprovalStep[]

  @@index([subjectType, subjectId])
  @@index([status])
}

model ApprovalStep {
  id          String          @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order       Int // 1-based
  requiredHat Hat // TECHNICAL_APPROVER, then BUSINESS_APPROVER for high-risk
  status      StepStatus      @default(PENDING)
  resolvedAt  DateTime?       @db.Timestamptz(3) // set when the step is decided (DESIGN §4.2)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  decisions ApprovalDecision[]

  @@unique([requestId, order])
}

model ApprovalDecision {
  id                       String       @id @default(cuid())
  stepId                   String
  step                     ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  actorId                  String
  actor                    User         @relation("ApprovalDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  decision                 DecisionKind
  reason                   String // required
  isSingleApproverOverride Boolean      @default(false) // true when actorId == request.createdById
  overrideJustification    String? // app-enforced: required when isSingleApproverOverride
  decidedAt                DateTime     @default(now()) @db.Timestamptz(3)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @db.Timestamptz(3)

  @@index([stepId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Support tables (spec 05, specs/data-model.md §"Support tables")
//
// Controller rulings applied here:
//  - Every DateTime carries @db.Timestamptz(3).
//  - Comment.authorId is a real @relation to User (onDelete: Restrict) — a
//    comment is a historical record.
//  - AuditEvent is APPEND-ONLY: it has NEITHER createdAt NOR updatedAt. Its
//    `at DateTime @default(now())` IS its creation time, and an append-only row
//    is never updated — adding updatedAt would be a contradiction. This is a
//    deliberate deviation from data-model.md §"Conventions" ("createdAt /
//    updatedAt on every table"). Its actorId is a bare nullable String (null for
//    system actions) with NO relation, so the row outlives any user lifecycle.
//    The INSERT/SELECT-only runtime grant is Task 7.
//  - Notification has createdAt ONLY (never updated except readAt). Its userId is
//    a real @relation to User with onDelete: Cascade — pure per-user UI ephemera
//    with no audit value; if the user goes, the feed goes.
//  - EmailOutbox has no user relation — it addresses a bare toEmail.
// ---------------------------------------------------------------------------

model Comment {
  id              String   @id @default(cuid())
  subjectType     String // Demand | Incident | Change
  subjectId       String
  authorId        String
  author          User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body            String
  visibleToClient Boolean  @default(false) // guests may only create true and only read true
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([subjectType, subjectId])
  @@index([authorId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now()) @db.Timestamptz(3) // creation time — append-only, so no createdAt/updatedAt
  actorId     String? // null for system actions; bare String, NO relation
  action      String // namespaced, matches the Action union
  subjectType String
  subjectId   String
  payload     Json? // before/after or decision detail
  requestId   String // correlates every event from one HTTP request

  @@index([subjectType, subjectId])
  @@index([actorId])
  @@index([requestId])
  @@index([at])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  subjectType String
  subjectId   String
  payload     Json // rendered title + link target
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt])
}

model EmailOutbox {
  id            String       @id @default(cuid())
  toEmail       String
  template      String // template id
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  sentAt        DateTime?    @db.Timestamptz(3)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3) // backoff schedule
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}
