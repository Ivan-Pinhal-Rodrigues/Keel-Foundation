{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/check-migrations.mjs",
    "test:watch": "vitest",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "seed": "dotenv -e .env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "next": "15.5.24",
    "nodemailer": "9.1.0",
    "pino": "10.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
